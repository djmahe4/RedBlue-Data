# Harness and workspace
REDBLUE_WORKSPACE=.
# Optional: allowed root for sandbox workspace mounts.
REDBLUE_WORKSPACES_ROOT=.
# Set a strong secret to enable syscall trace ingestion; blank disables it.
REDBLUE_TRACE_TOKEN=
REDBLUE_SANDBOX_IMAGE=redblue-sandbox
SEARXNG_URL=http://localhost:8080

# OCR: auto uses configured API/Ollama, otherwise local Tesseract.
OCR_PROVIDER=auto
OCR_CACHE_DIR=dataset/cache/ocr
OCR_TIMEOUT=120
# For a generic HTTP OCR endpoint, uncomment and configure:
# OCR_PROVIDER=api
# OCR_API_URL=https://your-ocr-service.example/v1/parse
# OCR_API_KEY=
# OCR_API_AUTH_SCHEME=Bearer
# OCR_API_HEADERS={}
# OCR_API_EXTRA_PAYLOAD={}
# OCR_MODEL=
# OCR_API_IMAGE_FIELD=image_base64
# OCR_API_PROMPT_FIELD=prompt
# OCR_API_MODEL_FIELD=model

# Optional VLM reasoning endpoint/model.
# VLM_API_URL=https://your-vlm-service.example/v1/parse
# VLM_API_KEY=
# VLM_MODEL=
# VLM_API_HEADERS={}

# Ollama OCR alternative. Set OCR_PROVIDER=ollama to select it explicitly.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_OCR_MODEL=llava

# Dataset pipeline defaults (CLI arguments override these).
MAX_REPORTS=30
MAX_FILE_SIZE_MB=5.0
OUTPUT_DIR=dataset
SKIP_OCR=false
MIN_WORDS=20
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2
